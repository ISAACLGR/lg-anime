# OAuth Configuration
; OAUTH_SERVER_URL=http://192.168.18.190:3000
OAUTH_SERVER_URL=https://lg-anime.vercel.app

# Database
DATABASE_URL=mysql://user:password@localhost:3306/animefire

# Expo
EXPO_PORT=8083

# API URL para acesso mobile (use IP local, nunca localhost)
; EXPO_PUBLIC_API_URL=http://192.168.18.190:3000
EXPO_PUBLIC_API_URL=https://lg-anime.vercel.app

# ScraperAPI Cache Configuration
# TTL em milissegundos (padrão: 2 horas = 7200000ms)
CACHE_TTL_MS=7200000

IS_LOCAL=false

